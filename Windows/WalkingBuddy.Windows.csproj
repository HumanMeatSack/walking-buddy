<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Walking Buddy</AssemblyName>
    <RootNamespace>WalkingBuddy.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.2.0</Version>
    <Authors>HumanMeatSack</Authors>
    <Description>A tiny draggable Windows desktop companion.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="../Resources/*.png" Link="Resources/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
